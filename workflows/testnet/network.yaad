name: testnet
about: What this network is for.

blocks:
  Problem:
    type: Formatter
    template: !file prompts/problem.txt

  Student:
    type: Gemini
    extension: .lean

  Grader:
    type: Lean

  Summarizer:
    type: Formatter
    template: !file prompts/summary.txt

  Teacher:
    type: Gemini

  Combiner:
    type: Formatter

wires:
  - Problem.output -> Student.body
  - Student.response -> Grader.code
  - Grader.errors  -> Summarizer.errors
  - Student.response -> Summarizer.code
  - Problem.output -> Summarizer.problem
  - Summarizer.output -> Teacher.body

layout:
  Problem: {at: [37.5, 142.5]}
  Student: {at: [142.5, 127.5]}
  Grader: {at: [277.5, 127.5]}
  Summarizer: {at: [405, 82.5]}
  Teacher: {at: [277.5, 217.5], facing: left}
  Combiner: {at: [112.5, 217.5]}
  wires:
    "Problem.output -> Summarizer.problem": [[126, 173], [126, 58.5], [386.5, 58.5]]
    "Student.response -> Summarizer.code": [[254.5, 158], [254.5, 113]]
    "Summarizer.output -> Teacher.body": [[504, 248]]
